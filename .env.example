# Copy to .env and adjust. Never commit .env.
# deploy/setup_vm.sh writes a production .env automatically on the VM.

# --- Local development -------------------------------------------------------
# DATABASE_URL unset => local SQLite (db.sqlite3).
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://gotani:password@localhost:5432/gotani

# Optional: Agromonitoring free-tier key (NDVI/EVI/NDWI/soil). Server-side only.
# Without it the satellite panel shows "data tidak tersedia"; weather (Open-Meteo) needs no key.
# AGRO_API_KEY=

# Password for seed_demo users (owner/manager/worker/cashier)
DEMO_PASSWORD=gotani-demo-2026

# --- Production (Azure VM, behind Caddy) --------------------------------------
# DEBUG=False
# SECRET_KEY=<50+ random chars: python -c "import secrets; print(secrets.token_urlsafe(50))">
# ALLOWED_HOSTS=gotani.duckdns.org
# CSRF_TRUSTED_ORIGINS=https://gotani.duckdns.org
# DATABASE_URL=postgres://gotani:<db-password>@localhost:5432/gotani
# SECURE_HSTS_SECONDS=3600
# SECURE_SSL_REDIRECT=True
# DJANGO_LOG_LEVEL=INFO
